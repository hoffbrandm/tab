# Copy to .env.local for local development. Never commit real secrets.

# Required in every environment. Use a long random string.
SESSION_SECRET=

# Who is allowed in. Must match the GitHub username after OAuth.
ALLOWED_GITHUB_LOGIN=hoffbrandm

# Server-side token used to read/write data/tab.json.
# Fine-grained PAT: Contents read/write on this repository only.
GITHUB_TOKEN=
GITHUB_REPO=hoffbrandm/tab
GITHUB_DATA_PATH=data/tab.json

# Optional. Sign in with GitHub (recommended on your phone).
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://YOUR_DOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Passphrase sign-in if you have not created an OAuth App yet.
TAB_PASSWORD=

# Public URL of the deployed app. Needed for GitHub OAuth redirects
# when the request host is not the public hostname.
APP_BASE_URL=

# Local-only. Writes data/tab.json on disk instead of calling GitHub.
# Do not set this on Vercel.
STORE_DRIVER=file
